# PostgreSQL (Prisma)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tlaloc?schema=public"
# Optional: direct DB URL for Prisma migrations (Supabase/managed DBs)
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/tlaloc?schema=public"

# Email (SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=notifications@example.com
SMTP_PASS=change_me
SMTP_FROM=Tláloc Cantina <notifications@example.com>
RESERVATION_NOTIFY_EMAIL=bookings@tlaloccantina.pt
# Public app URL used to build reservation confirmation links in email
APP_BASE_URL=https://tlaloccantina.pt
# Secret for signing reservation confirmation links
RESERVATION_CONFIRM_SECRET=replace_with_long_random_secret

# WhatsApp via Twilio
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
WHATSAPP_NOTIFY_TO=whatsapp:+351933357555

# Admin access
# Used once to bootstrap first admin in Prisma if no admin users exist.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me
# Required in production: cookie/session signing secret
ADMIN_SESSION_SECRET=replace_with_long_random_secret
