generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ReservationStatus {
  new
  confirmed
  cancelled
}

enum Locale {
  en
  pt
}

model Reservation {
  id        String            @id @default(cuid())
  locale    Locale
  firstName String
  lastName  String
  phone     String
  email     String
  date      String
  time      String
  guests    String
  occasion  String?
  notes     String?
  isRead    Boolean           @default(false)
  status    ReservationStatus @default(new)
  createdAt DateTime          @default(now())

  @@index([createdAt(sort: Desc)])
  @@index([date, time])
  @@index([isRead, status, createdAt(sort: Desc)])
}

model AdminUser {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model MenuSection {
  id         String     @id @default(cuid())
  slug       String     @unique
  titleEn    String
  titlePt    String
  subtitleEn String?
  subtitlePt String?
  order      Int        @default(0)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  items      MenuItem[]

  @@index([order])
}

model MenuItem {
  id            String      @id @default(cuid())
  sectionId     String
  nameEn        String
  namePt        String
  descriptionEn String
  descriptionPt String
  price         String
  vegetarian    Boolean     @default(false)
  order         Int         @default(0)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  section       MenuSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@index([sectionId, order])
}

model WorkingHours {
  id          String   @id @default(cuid())
  weekday     Int      @unique
  isClosed    Boolean  @default(false)
  lunchOpen   String?
  lunchClose  String?
  dinnerOpen  String?
  dinnerClose String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([weekday])
}

model MessageTemplate {
  id        String   @id @default(cuid())
  key       String   @unique
  subjectEn String
  subjectPt String
  bodyEn    String
  bodyPt    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
