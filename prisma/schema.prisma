generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ReservationStatus {
  new
  confirmed
  cancelled
}

enum Locale {
  en
  pt
}

model Reservation {
  id        String            @id @default(cuid())
  locale    Locale
  firstName String
  lastName  String
  phone     String
  email     String
  date      String
  time      String
  guests    String
  occasion  String?
  notes     String?
  status    ReservationStatus @default(new)
  createdAt DateTime          @default(now())

  @@index([createdAt(sort: Desc)])
  @@index([date, time])
}

model AdminUser {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model MenuSection {
  id         String     @id @default(cuid())
  slug       String     @unique
  titleEn    String
  titlePt    String
  subtitleEn String?
  subtitlePt String?
  order      Int        @default(0)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  items      MenuItem[]

  @@index([order])
}

model MenuItem {
  id            String      @id @default(cuid())
  sectionId     String
  nameEn        String
  namePt        String
  descriptionEn String
  descriptionPt String
  price         String
  vegetarian    Boolean     @default(false)
  order         Int         @default(0)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  section       MenuSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@index([sectionId, order])
}
