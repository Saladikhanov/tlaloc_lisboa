generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ReservationStatus {
  new
  confirmed
  cancelled
  no_show
}

enum RewardType {
  percent
  fixed_amount
  free_item
  custom
}

enum RewardCodeStatus {
  active
  used
  cancelled
}

enum Locale {
  en
  pt
}

model Reservation {
  id        String            @id @default(cuid())
  locale    Locale
  firstName String
  lastName  String
  phone     String
  email     String
  date      String
  time      String
  guests    String
  occasion  String?
  notes     String?
  isRead    Boolean           @default(false)
  status    ReservationStatus @default(new)
  createdAt DateTime          @default(now())

  @@index([createdAt(sort: Desc)])
  @@index([date, time])
  @@index([isRead, status, createdAt(sort: Desc)])
}

model ReservationV2 {
  id         String            @id @default(cuid())
  locale     Locale
  fullName   String
  phone      String
  email      String?
  date       String
  time       String
  guests     String
  otherInfo  String?
  isRead     Boolean           @default(false)
  isTest     Boolean           @default(false)
  status     ReservationStatus @default(new)
  archivedAt DateTime?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@index([createdAt(sort: Desc)])
  @@index([date, time])
  @@index([isRead, status, createdAt(sort: Desc)])
  @@index([archivedAt])
}

model AdminUser {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model MenuSection {
  id         String     @id @default(cuid())
  slug       String     @unique
  titleEn    String
  titlePt    String
  subtitleEn String?
  subtitlePt String?
  order      Int        @default(0)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  items      MenuItem[]

  @@index([order])
}

model MenuItem {
  id            String      @id @default(cuid())
  sectionId     String
  nameEn        String
  namePt        String
  descriptionEn String
  descriptionPt String
  price         String
  vegetarian    Boolean     @default(false)
  order         Int         @default(0)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  section       MenuSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@index([sectionId, order])
}

model WorkingHours {
  id          String   @id @default(cuid())
  weekday     Int      @unique
  isClosed    Boolean  @default(false)
  lunchOpen   String?
  lunchClose  String?
  dinnerOpen  String?
  dinnerClose String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([weekday])
}

model ReservationClosure {
  id        String   @id @default(cuid())
  date      String
  startTime String
  endTime   String
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date, startTime])
}

model MessageTemplate {
  id        String   @id @default(cuid())
  key       String   @unique
  subjectEn String
  subjectPt String
  bodyEn    String
  bodyPt    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TutorialSettings {
  id            String   @id @default("default")
  businessPhone String
  businessEmail String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model RewardProgramSettings {
  id             String     @id @default("default")
  isEnabled      Boolean    @default(false)
  visitThreshold Int        @default(3)
  rewardType     RewardType @default(percent)
  rewardValue    String     @default("10")
  rewardLabel    String     @default("10% off")
  messageEn      String?
  messagePt      String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
}

model RewardCode {
  id                          String           @id @default(cuid())
  code                        String           @unique
  status                      RewardCodeStatus @default(active)
  phoneKey                    String?
  emailKey                    String?
  guestName                   String?
  rewardType                  RewardType
  rewardValue                 String
  rewardLabel                 String
  messageEn                   String?
  messagePt                   String?
  generatedAfterConfirmedCount Int
  originReservationId         String?
  originReservationVersion    String?
  usedByReservationId         String?
  usedByReservationVersion    String?
  usedAt                      DateTime?
  cancelledAt                 DateTime?
  createdAt                   DateTime         @default(now())
  updatedAt                   DateTime         @updatedAt

  @@index([status, createdAt(sort: Desc)])
  @@index([phoneKey, status])
  @@index([emailKey, status])
}
